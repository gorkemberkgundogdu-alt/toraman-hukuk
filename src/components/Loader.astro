---
<div id="loader" hidden aria-label="Sayfa hazırlanıyor">
  <img class="loader-logo" src="/images/logo.png" width="243" height="49" alt="Toraman Hukuk" />
  <p class="loader-caption">2004’ten bu yana kararlı bir hukuki duruş.</p>
  <div class="loader-progress" aria-hidden="true"><span class="loader-progress-fill"></span></div>
  <p id="load-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true">Sayfa hazırlanıyor.</p>
</div>
<noscript><style>#loader { display: none !important; }</style></noscript>
<script is:inline>
  // Start before React hydration; unavailable storage never blocks the page.
  (() => {
    const loader = document.getElementById('loader');
    if (!loader) return;
    const sessionKey = 'toraman:intro:v2';
    try { loader.dataset.repeat = String(sessionStorage.getItem(sessionKey) === 'seen'); } catch {}
    window.addEventListener('toraman:scene-ready', () => { loader.dataset.sceneReady = 'true'; }, { once: true });
    loader.hidden = false;
    loader.dataset.started = String(performance.now());
    const fallback = window.setTimeout(() => {
      if (loader.hidden) return;
      document.documentElement.dataset.experienceEntered = 'true';
      window.dispatchEvent(new Event('toraman:enter'));
      document.getElementById('load-status').textContent = 'İçerik hazır; sayfayı keşfedebilirsiniz.';
      loader.dispatchEvent(new Event('toraman:loader-timeout'));
      try { sessionStorage.setItem(sessionKey, 'seen'); } catch {}
      if (typeof loader.animate === 'function') {
        const exit = loader.animate([{ opacity: 1 }, { opacity: 0 }], { duration: matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 200 });
        exit.finished.then(() => { loader.hidden = true; }).catch(() => { loader.hidden = true; });
      } else loader.hidden = true;
    }, 4000);
    loader.addEventListener('toraman:loader-exit', () => window.clearTimeout(fallback), { once: true });
  })();
</script>
