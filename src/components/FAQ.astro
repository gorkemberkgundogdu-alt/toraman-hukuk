---
import { faqs } from '../data/content';
interface Props {
  items?: { question: string; answer: string }[];
  id?: string;
}
const { items = faqs, id = 'sorular' } = Astro.props;
---
<section class="faq-section" id={id} aria-labelledby={`${id}-heading`} data-scene="faq">
  <p class="section-label">Sık sorulan sorular</p>
  <h2 class="faq-heading" id={`${id}-heading`} data-reveal>İlk adım için<br />bilmeniz gerekenler.</h2>
  <div class="faq-list">
    {items.map((item) => <details class="faq-item" data-reveal>
      <summary><span class="faq-question">{item.question}</span></summary>
      <div class="faq-answer"><p>{item.answer}</p></div>
    </details>)}
  </div>
</section>
