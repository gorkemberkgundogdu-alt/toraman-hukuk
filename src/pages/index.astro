---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene';
import Loader from '../components/Loader.astro';
import FAQ from '../components/FAQ.astro';
import { areas, team } from '../data/content';
---
<Layout>
  <Loader />
  <Scene client:load />
  <nav class="page-progress" aria-label="Sayfa bölümleri">
    <a href="#baslangic" class="is-active"><span></span>Başlangıç</a>
    <a href="#alanlar"><span></span>Çalışma alanları</a>
    <a href="#yaklasim"><span></span>Toraman Hukuk</a>
    <a href="#ekip"><span></span>Ekibimiz</a>
    <a href="#sorular"><span></span>Sık sorulan sorular</a>
    <a href="#iletisim"><span></span>İletişim</a>
  </nav>
  <a class="contact-launch" href="#iletisim"><span aria-hidden="true">→</span>İletişime geçin</a>
  <main id="main-content" class="scene-story">
    <section class="hero" id="baslangic" data-scene="hero">
      <div class="hero-eyebrow">TORAMAN HUKUK · İSTANBUL</div>
      <h1 class="hero-title"><span>Kararlı bir</span><span>hukuki duruş.</span></h1>
      <a class="hero-contact" href="#iletisim">İletişime geçin <span aria-hidden="true">↗</span></a>
      <div class="hero-bottom">
        <p class="hero-description">Toraman Hukuk, 2004 yılından bu yana hukuki danışmanlık, dava takibi ve uyuşmazlık çözümü hizmetleri sunmaktadır.</p>
        <p class="hero-credentials">İstanbul Barosu<br />Hukuki danışmanlık &amp; temsil<br />Arabuluculuk &amp; uyuşmazlık çözümü</p>
      </div>
      <a class="scroll-cue" href="#alanlar">Keşfetmek için kaydırın <span aria-hidden="true">↓</span></a>
    </section>
    <section class="practice-section" id="alanlar" data-scene="practice">
      <h2 class="section-title" data-reveal>Çalışma<br />alanlarımız.</h2>
      <div class="practice-grid">
        {areas.map((area) => <a class="practice-item" href={`/calisma-alanlari/${area.slug}/`} data-reveal><span class="practice-number" aria-hidden="true">{area.id}</span><div class="practice-text"><h3 class="practice-name">{area.title}</h3><p class="practice-description">{area.description}</p><span class="practice-detail">Alanı inceleyin <span aria-hidden="true">↗</span></span></div></a>)}
      </div>
    </section>
    <section class="about-section" id="yaklasim" data-scene="about">
      <div class="about-content">
        <p class="section-label">2004’TEN BUGÜNE</p><h2 class="about-title" data-reveal>Toraman<br />Hukuk.</h2>
        <div class="about-copy" data-reveal><p>Toraman Hukuk, 2004 yılında İstanbul Barosu’na kayıtlı Arabulucu Avukat Tuğrul Toraman tarafından Kadıköy’de kurulmuştur.</p><p>Bireylerin ve şirketlerin hukuki ihtiyaçlarını, konunun özelliklerini ve olası sonuçlarını birlikte değerlendirerek ele alır. Danışmanlıktan dava takibine ve uyuşmazlıkların çözümüne uzanan süreçlerde; açık iletişimi, dikkatli hazırlığı ve düzenli bilgilendirmeyi esas alır.</p></div>
        <p class="about-signature">Arb. Av. Tuğrul Toraman<br /><span>Kurucu</span></p>
      </div>
    </section>
    <section class="team-section" id="ekip" data-scene="team">
      <h2 class="section-title" data-reveal>Ekibimizle<br />tanışın.</h2>
      <div class="team-grid">{team.map((person,index) => <article class="team-card" data-reveal><div class="team-photo"><img src={person.image} alt={person.name} width="700" height="900" loading="lazy" decoding="async" /><span class="team-index">0{index+1}</span></div><div class="team-info"><h3 class="team-name">{person.name}</h3><p class="team-role">{person.role}</p>{person.education && <p class="team-education">{person.education}</p>}</div></article>)}</div>
      <p class="bar-note">Avukatlarımız İstanbul Barosu’na kayıtlıdır.</p>
    </section>
    <FAQ />
  </main>
</Layout>
